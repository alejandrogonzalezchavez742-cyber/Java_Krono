<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Diálogo modal "Configurar / Enlazar Base de Datos" -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.krono.controller.DbConfigController"
      styleClass="db-dialog" spacing="16.0" prefWidth="460.0">
   <padding>
      <Insets top="24.0" right="24.0" bottom="20.0" left="24.0" />
   </padding>

   <!-- Encabezado -->
   <VBox spacing="4.0">
      <Label text="Enlazar base de datos" styleClass="db-title" />
      <Label text="Krono guarda tu calendario, tarjetas y contactos en PostgreSQL."
             styleClass="db-subtitle" wrapText="true" />
   </VBox>

   <!-- Motivo (error de arranque). Oculto si no hay. -->
   <Label fx:id="lblMotivo" styleClass="db-banner, db-banner-error" wrapText="true"
          maxWidth="Infinity" managed="false" visible="false" />

   <!-- Campos -->
   <GridPane styleClass="db-card" hgap="12.0" vgap="10.0">
      <padding>
         <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
      </padding>
      <columnConstraints>
         <ColumnConstraints minWidth="110.0" />
         <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>

      <Label text="Host" GridPane.rowIndex="0" GridPane.columnIndex="0" />
      <TextField fx:id="txtHost" promptText="localhost" GridPane.rowIndex="0" GridPane.columnIndex="1" />

      <Label text="Puerto" GridPane.rowIndex="1" GridPane.columnIndex="0" />
      <TextField fx:id="txtPuerto" promptText="5432" maxWidth="110.0"
                 GridPane.rowIndex="1" GridPane.columnIndex="1" />

      <Label text="Base de datos" GridPane.rowIndex="2" GridPane.columnIndex="0" />
      <TextField fx:id="txtBaseDatos" promptText="krono_db" GridPane.rowIndex="2" GridPane.columnIndex="1" />

      <Label text="Usuario" GridPane.rowIndex="3" GridPane.columnIndex="0" />
      <TextField fx:id="txtUsuario" promptText="postgres" GridPane.rowIndex="3" GridPane.columnIndex="1" />

      <Label text="Contraseña" GridPane.rowIndex="4" GridPane.columnIndex="0" />
      <PasswordField fx:id="txtPassword" GridPane.rowIndex="4" GridPane.columnIndex="1" />
   </GridPane>

   <CheckBox fx:id="chkCrearTablas" selected="true"
             text="Crear las tablas automáticamente si la base de datos está vacía" wrapText="true" />

   <!-- Estado de la prueba -->
   <HBox fx:id="boxEstado" spacing="10.0" alignment="CENTER_LEFT" managed="false" visible="false">
      <ProgressIndicator fx:id="progreso" prefWidth="18.0" prefHeight="18.0" />
      <Label fx:id="lblEstado" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
   </HBox>

   <Label fx:id="lblArchivo" styleClass="db-hint" wrapText="true" />

   <!-- Botones -->
   <HBox spacing="10.0" alignment="CENTER_RIGHT">
      <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#onCancelar" />
      <Button fx:id="btnProbar" text="Probar y guardar conexión" defaultButton="true"
              styleClass="db-primary" onAction="#onProbarYGuardar" />
   </HBox>
</VBox>
