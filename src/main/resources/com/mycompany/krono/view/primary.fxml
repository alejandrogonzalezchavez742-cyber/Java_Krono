<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<!-- Ventana principal de Krono -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.krono.controller.MainController"
            styleClass="app-root">

   <fx:define>
      <ToggleGroup fx:id="grupoVistas" />
   </fx:define>

   <!-- ================= Barra superior ================= -->
   <top>
      <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12.0">
         <HBox spacing="10.0" alignment="CENTER_LEFT" minWidth="180.0">
            <StackPane styleClass="brand-mark">
               <Label text="K" styleClass="brand-mark-text" />
            </StackPane>
            <Label text="Krono" styleClass="brand" />
         </HBox>

         <Region HBox.hgrow="ALWAYS" />

         <!-- Selector de vista (segmentado) -->
         <HBox styleClass="nav-segment" alignment="CENTER" spacing="2.0">
            <ToggleButton fx:id="tabCalendario" text="Calendario" toggleGroup="$grupoVistas"
                          selected="true" styleClass="nav-button" />
            <ToggleButton fx:id="tabTarjetas" text="Tarjetas y Gastos" toggleGroup="$grupoVistas"
                          styleClass="nav-button" />
            <ToggleButton fx:id="tabDirectorio" text="Directorio" toggleGroup="$grupoVistas"
                          styleClass="nav-button" />
         </HBox>

         <Region HBox.hgrow="ALWAYS" />

         <HBox spacing="4.0" alignment="CENTER_RIGHT" minWidth="180.0">
            <Button fx:id="btnTema" styleClass="icon-button" onAction="#onAlternarTema" />
            <Button fx:id="btnConfigBD" styleClass="icon-button" onAction="#onConfigurarBD" />
         </HBox>
      </HBox>
   </top>

   <!-- ================= Vistas ================= -->
   <center>
      <StackPane>
         <fx:include fx:id="calendario" source="calendario.fxml" />
         <fx:include fx:id="tarjetas" source="tarjetas.fxml" visible="false" />
         <fx:include fx:id="directorio" source="directorio.fxml" visible="false" />
      </StackPane>
   </center>
</BorderPane>
